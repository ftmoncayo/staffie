// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isVenueAdmin Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  profile      Profile?
  venues       Venue[]

  managedVenues         VenueManager[]       @relation("VenueManagerUser")
  assignedVenueManagers VenueManager[]       @relation("VenueManagerAssignedBy")
  passwordResetTokens   PasswordResetToken[]

  managerNominations         ManagerNomination[] @relation("ManagerNominationNominee")
  respondedManagerNominations ManagerNomination[] @relation("ManagerNominationRespondedBy")

  sentInvites Invite[] @relation("InviteInviter")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionRequestFrom")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionRequestTo")

  venueFollows VenueFollow[]

  businesses Business[]

  managedBusinesses        BusinessManager[] @relation("BusinessManagerUser")
  assignedBusinessManagers BusinessManager[] @relation("BusinessManagerAssignedBy")
  businessFollows          BusinessFollow[]

  activities Activity[]
  posts      Post[]
  notices    Notice[]
  comments   Comment[]
  nods       Nod[]

  postedJobs      Job[]
  jobApplications JobApplication[]

  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationSource")

  endorsementsGiven Endorsement[]

  createdEvents  Event[]
  eventInterests EventInterest[]
}

enum ActivityType {
  SIGNUP
  CONNECTION_MADE
  EXPERIENCE_ADDED
  CERTIFICATION_ADDED
  PROFILE_UPDATED
  VENUE_CREATED
  BUSINESS_CREATED
  NOTICE_POSTED
  JOB_POSTED
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  actorUserId String?
  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  noticeId    String?      @unique
  notice      Notice?      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  jobId       String?      @unique
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  experienceId String?     @unique
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  // Scoped to NOTICE_POSTED only: bumped to now() whenever a new comment is
  // added to the notice, so an old notice with fresh engagement resurfaces
  // in the feed instead of staying buried under its original createdAt.
  // Every other activity type just leaves this equal to createdAt.
  lastEngagementAt DateTime @default(now())
}

model Notice {
  id           String            @id @default(uuid())
  targetType   ManagerTargetType
  targetId     String
  authorUserId String
  authorUser   User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime          @default(now())

  activity Activity?
}

enum JobStatus {
  OPEN
  CLOSED
}

model Job {
  id             String    @id @default(uuid())
  title          String
  description    String
  status         JobStatus @default(OPEN)
  venueId        String
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  postedByUserId String
  postedByUser   User      @relation(fields: [postedByUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  skills         JobSkill[]
  knowledgeAreas JobKnowledgeArea[]
  applications   JobApplication[]
  activity       Activity?
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
}

model JobKnowledgeArea {
  id              String        @id @default(uuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  knowledgeAreaId String
  knowledgeArea   KnowledgeArea @relation(fields: [knowledgeAreaId], references: [id])

  @@unique([jobId, knowledgeAreaId])
}

model JobApplication {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantUserId String
  applicantUser   User     @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime @default(now())

  @@unique([jobId, applicantUserId])
}

model VenueFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, venueId])
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ConnectionRequest {
  id          String                  @id @default(uuid())
  fromUserId  String
  fromUser    User                    @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                    @relation("ConnectionRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status      ConnectionRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  suburbId          String?
  suburb            Suburb?  @relation(fields: [suburbId], references: [id])
  professionalTitle String
  rightToWork       Boolean
  culturalIdentity  String?
  about             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills         Skill[]
  knowledgeAreas KnowledgeArea[]
  experiences    Experience[]
  certifications Certification[]
  endorsements   Endorsement[]
  upskillings    Upskilling[]
}

model Country {
  id        String @id @default(uuid())
  name      String @unique
  states    State[]
  businesses Business[]
  events    Event[]
}

model State {
  id        String  @id @default(uuid())
  name      String  @unique
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]
  events    Event[]
}

model City {
  id                String             @id @default(uuid())
  name              String             @unique
  stateId           String
  state             State              @relation(fields: [stateId], references: [id])
  profiles          Profile[]
  venues            Venue[]
  suburbs           Suburb[]
  posts             Post[]
  businessLocations BusinessLocation[]
  events            Event[]
}

model Post {
  id           String   @id @default(uuid())
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  cityId       String?
  city         City?    @relation(fields: [cityId], references: [id])
  createdAt    DateTime @default(now())
  // Bumped to now() whenever a new comment is added (see routes/engagement.js),
  // so a Post resurfaces on the city feed after fresh engagement instead of
  // staying pinned to its original post time. Every Post can bump — unlike
  // Activity, there's no type restriction here.
  lastEngagementAt DateTime @default(now())
}

model Suburb {
  id       String    @id @default(uuid())
  name     String
  cityId   String
  city     City      @relation(fields: [cityId], references: [id])
  venues   Venue[]
  profiles Profile[]
  events   Event[]

  @@unique([name, cityId])
}

model Skill {
  id          String       @id @default(uuid())
  name        String       @unique
  profiles    Profile[]
  jobSkills   JobSkill[]
  eventSkills EventSkill[]
}

model KnowledgeArea {
  id                  String               @id @default(uuid())
  name                String               @unique
  profiles            Profile[]
  jobKnowledgeAreas   JobKnowledgeArea[]
  eventKnowledgeAreas EventKnowledgeArea[]
}

model Experience {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id])
  roleTitle String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  activity Activity?
}

enum VenueVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model Venue {
  id                 String                  @id @default(uuid())
  name               String
  cityId             String?
  city               City?                   @relation(fields: [cityId], references: [id])
  suburbId           String?
  suburb             Suburb?                 @relation(fields: [suburbId], references: [id])
  venueTypeId        String
  venueType          VenueType               @relation(fields: [venueTypeId], references: [id])
  verificationStatus VenueVerificationStatus @default(UNVERIFIED)
  about              String?
  createdByUserId    String
  createdByUser      User                    @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                @default(now())

  specialties VenueSpecialty[]
  experiences Experience[]
  managers    VenueManager[]
  followers   VenueFollow[]
  activities  Activity[]
  invites     Invite[]
  jobs        Job[]
}

model VenueManager {
  id               String   @id @default(uuid())
  venueId          String
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("VenueManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("VenueManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())
  verified         Boolean  @default(true)

  @@unique([venueId, userId])
}

model VenueSpecialty {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model VenueType {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model CertificationType {
  id             String          @id @default(uuid())
  name           String          @unique
  certifications Certification[]
}

model Certification {
  id                  String            @id @default(uuid())
  profileId           String
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificationTypeId String
  certificationType   CertificationType @relation(fields: [certificationTypeId], references: [id])
  issueDate           DateTime
  expiryDate          DateTime?
}

model BusinessCategory {
  id         String     @id @default(uuid())
  name       String     @unique
  businesses Business[]
}

enum BusinessVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum BusinessLocationScope {
  SPECIFIC_CITIES
  COUNTRY
  GLOBAL
}

model Business {
  id                 String                     @id @default(uuid())
  name               String
  categoryId         String?
  category           BusinessCategory?          @relation(fields: [categoryId], references: [id])
  about              String?
  verificationStatus BusinessVerificationStatus @default(UNVERIFIED)
  locationScope      BusinessLocationScope       @default(SPECIFIC_CITIES)
  countryId          String?
  country            Country?                   @relation(fields: [countryId], references: [id])
  createdByUserId    String
  createdByUser      User                       @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                   @default(now())

  managers   BusinessManager[]
  followers  BusinessFollow[]
  activities Activity[]
  locations  BusinessLocation[]
  invites    Invite[]
}

model BusinessLocation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])

  @@unique([businessId, cityId])
}

model BusinessManager {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("BusinessManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("BusinessManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())
  verified         Boolean  @default(true)

  @@unique([businessId, userId])
}

model BusinessFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, businessId])
}

enum ManagerTargetType {
  VENUE
  BUSINESS
}

enum NominationStatus {
  PENDING
  APPROVED
  DECLINED
}

model ManagerNomination {
  id                String            @id @default(uuid())
  targetType        ManagerTargetType
  targetId          String
  nomineeUserId     String
  nomineeUser       User              @relation("ManagerNominationNominee", fields: [nomineeUserId], references: [id], onDelete: Cascade)
  message           String
  status            NominationStatus  @default(PENDING)
  createdAt         DateTime          @default(now())
  respondedByUserId String?
  respondedByUser   User?             @relation("ManagerNominationRespondedBy", fields: [respondedByUserId], references: [id])
  respondedAt       DateTime?
}

enum InviteType {
  GENERAL
  VENUE_COWORKER
  VENUE_MANAGER_NUDGE
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model Invite {
  id            String       @id @default(uuid())
  inviterUserId String
  inviterUser   User         @relation("InviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeEmail  String
  venueId       String?
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type          InviteType
  token         String       @unique
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  expiresAt     DateTime
}

// Shared by Comment and Nod so both post and activity engagement live in one
// pair of tables instead of four near-identical ones.
enum EngagementTargetType {
  POST
  ACTIVITY
}

model Comment {
  id           String               @id @default(uuid())
  targetType   EngagementTargetType
  targetId     String
  authorUserId String
  authorUser   User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime             @default(now())

  @@index([targetType, targetId])
}

model Nod {
  id         String               @id @default(uuid())
  targetType EngagementTargetType
  targetId   String
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())

  @@unique([targetType, targetId, userId])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  COMMENT
  NOD
  ENDORSEMENT_REQUEST
  EVENT_INTEREST
  ATTENDANCE_CONFIRM
  MANAGER_NOMINATION_APPROVED
  MANAGER_NOMINATION_DECLINED
}

// Reuses EngagementTargetType's POST/ACTIVITY values plus CONNECTION_REQUEST,
// mirroring the targetType/targetId discriminator pattern used by Notice,
// Comment, and Nod rather than a dedicated join table per notification kind.
// SKILL/KNOWLEDGE_AREA (targetId = Skill.id / KnowledgeArea.id) back
// ENDORSEMENT_REQUEST notifications the same way. EVENT (targetId =
// Event.id) backs both EVENT_INTEREST (sourceUserId is the interested
// worker; the note is looked up via the eventId+sourceUserId EventInterest
// row at read time) and ATTENDANCE_CONFIRM (system-generated, no source).
// VENUE/BUSINESS (targetId = Venue.id / Business.id, taken directly from the
// resolved ManagerNomination's own targetType/targetId) back
// MANAGER_NOMINATION_APPROVED/DECLINED.
enum NotificationTargetType {
  CONNECTION_REQUEST
  POST
  ACTIVITY
  SKILL
  KNOWLEDGE_AREA
  EVENT
  VENUE
  BUSINESS
}

enum EndorsementItemType {
  SKILL
  KNOWLEDGE_AREA
}

enum EndorsementRole {
  PEER
  MANAGER
}

// No FK on itemId — it points at a Skill.id or KnowledgeArea.id depending on
// itemType, the same discriminator-without-relation pattern Comment/Nod use
// for POST/ACTIVITY. Level is derived (not stored): MANAGER role present ->
// 3, else PEER present -> 2, else 1.
model Endorsement {
  id             String              @id @default(uuid())
  profileId      String
  profile        Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemType       EndorsementItemType
  itemId         String
  endorserUserId String
  endorserUser   User                @relation(fields: [endorserUserId], references: [id], onDelete: Cascade)
  endorserRole   EndorsementRole
  createdAt      DateTime            @default(now())

  @@unique([profileId, itemType, itemId, endorserUserId])
}

model Notification {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  sourceUserId String?
  sourceUser   User?                  @relation("NotificationSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  targetType   NotificationTargetType
  targetId     String
  read         Boolean                @default(false)
  dismissed    Boolean                @default(false)
  createdAt    DateTime               @default(now())

  @@index([userId, read])
}

// A self-declared item upgrades to this tier once training attendance is
// confirmed for it, sitting between the self-declared default (Level 1) and
// a peer Endorsement (Level 2) — order: 1 < Upskilling < 2 < 3. Never
// created if a peer/manager Endorsement already exists for the item (see
// PUT /api/events/:id/confirm-attendance).
model Upskilling {
  id        String              @id @default(uuid())
  profileId String
  profile   Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemType  EndorsementItemType
  itemId    String
  createdAt DateTime            @default(now())

  @@unique([profileId, itemType, itemId])
}

model EventCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  events Event[]
}

// ownerType/ownerId is a plain discriminator (no FK), mirroring how Notice
// and ManagerNomination point at either a Venue or a Business — creating
// and editing an event follows that owner entity's own edit permission
// (canEditVenue/canEditBusiness), checked in routes/events.js.
model Event {
  id              String            @id @default(uuid())
  title           String
  description     String
  categoryId      String
  category        EventCategory     @relation(fields: [categoryId], references: [id])
  ownerType       ManagerTargetType
  ownerId         String
  startAt         DateTime
  endAt           DateTime?
  countryId       String?
  country         Country?          @relation(fields: [countryId], references: [id])
  stateId         String?
  state           State?            @relation(fields: [stateId], references: [id])
  cityId          String?
  city            City?             @relation(fields: [cityId], references: [id])
  suburbId        String?
  suburb          Suburb?           @relation(fields: [suburbId], references: [id])
  createdByUserId String
  createdByUser   User              @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())

  skills         EventSkill[]
  knowledgeAreas EventKnowledgeArea[]
  interests      EventInterest[]

  @@index([ownerType, ownerId])
}

model EventSkill {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([eventId, skillId])
}

model EventKnowledgeArea {
  id              String        @id @default(uuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  knowledgeAreaId String
  knowledgeArea   KnowledgeArea @relation(fields: [knowledgeAreaId], references: [id])

  @@unique([eventId, knowledgeAreaId])
}

enum EventInterestStatus {
  INTERESTED
  ATTENDED
  DID_NOT_ATTEND
}

// A DID_NOT_ATTEND row is kept (not deleted) so it can never be re-asked via
// the lazy attendance-confirmation check (askedAt already set), but every
// profile-facing query explicitly excludes it — it never appears in training
// history, unlike INTERESTED/ATTENDED which both show (as "Interested" and
// "Attended" respectively).
model EventInterest {
  id        String              @id @default(uuid())
  eventId   String
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  status    EventInterestStatus @default(INTERESTED)
  askedAt   DateTime?
  createdAt DateTime            @default(now())

  @@unique([eventId, userId])
}
