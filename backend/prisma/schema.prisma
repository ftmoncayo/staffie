// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isVenueAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  profile      Profile?
  venues       Venue[]

  managedVenues         VenueManager[] @relation("VenueManagerUser")
  assignedVenueManagers VenueManager[] @relation("VenueManagerAssignedBy")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  professionalTitle String
  rightToWork       Boolean
  culturalIdentity  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills         Skill[]
  knowledgeAreas KnowledgeArea[]
  experiences    Experience[]
  certifications Certification[]
}

model City {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
  venues   Venue[]
  suburbs  Suburb[]
}

model Suburb {
  id     String  @id @default(uuid())
  name   String
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  venues Venue[]

  @@unique([name, cityId])
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model KnowledgeArea {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model Experience {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id])
  roleTitle String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
}

enum VenueVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model Venue {
  id                 String                  @id @default(uuid())
  name               String
  cityId             String?
  city               City?                   @relation(fields: [cityId], references: [id])
  suburbId           String?
  suburb             Suburb?                 @relation(fields: [suburbId], references: [id])
  state              String?
  country            String?
  venueTypeId        String?
  venueType          VenueType?              @relation(fields: [venueTypeId], references: [id])
  verificationStatus VenueVerificationStatus @default(UNVERIFIED)
  createdByUserId    String
  createdByUser      User                    @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                @default(now())

  specialties VenueSpecialty[]
  experiences Experience[]
  managers    VenueManager[]
}

model VenueManager {
  id               String   @id @default(uuid())
  venueId          String
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("VenueManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("VenueManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())

  @@unique([venueId, userId])
}

model VenueSpecialty {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model VenueType {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model CertificationType {
  id             String          @id @default(uuid())
  name           String          @unique
  certifications Certification[]
}

model Certification {
  id                  String            @id @default(uuid())
  profileId           String
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificationTypeId String
  certificationType   CertificationType @relation(fields: [certificationTypeId], references: [id])
  issueDate           DateTime
  expiryDate          DateTime?
}
