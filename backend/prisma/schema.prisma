// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isVenueAdmin Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  profile      Profile?
  venues       Venue[]

  managedVenues         VenueManager[]       @relation("VenueManagerUser")
  assignedVenueManagers VenueManager[]       @relation("VenueManagerAssignedBy")
  passwordResetTokens   PasswordResetToken[]

  managerNominations         ManagerNomination[] @relation("ManagerNominationNominee")
  respondedManagerNominations ManagerNomination[] @relation("ManagerNominationRespondedBy")

  sentInvites Invite[] @relation("InviteInviter")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionRequestFrom")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionRequestTo")

  venueFollows VenueFollow[]

  businesses Business[]

  managedBusinesses        BusinessManager[] @relation("BusinessManagerUser")
  assignedBusinessManagers BusinessManager[] @relation("BusinessManagerAssignedBy")
  businessFollows          BusinessFollow[]

  activities Activity[]
  posts      Post[]
  notices    Notice[]
  comments   Comment[]
  nods       Nod[]

  postedJobs      Job[]
  jobApplications JobApplication[]

  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationSource")

  endorsementsGiven Endorsement[]
}

enum ActivityType {
  SIGNUP
  CONNECTION_MADE
  EXPERIENCE_ADDED
  CERTIFICATION_ADDED
  PROFILE_UPDATED
  VENUE_CREATED
  BUSINESS_CREATED
  NOTICE_POSTED
  JOB_POSTED
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  actorUserId String?
  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  noticeId    String?      @unique
  notice      Notice?      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  jobId       String?      @unique
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
}

model Notice {
  id           String            @id @default(uuid())
  targetType   ManagerTargetType
  targetId     String
  authorUserId String
  authorUser   User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime          @default(now())

  activity Activity?
}

enum JobStatus {
  OPEN
  CLOSED
}

model Job {
  id             String    @id @default(uuid())
  title          String
  description    String
  status         JobStatus @default(OPEN)
  venueId        String
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  postedByUserId String
  postedByUser   User      @relation(fields: [postedByUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  skills         JobSkill[]
  knowledgeAreas JobKnowledgeArea[]
  applications   JobApplication[]
  activity       Activity?
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
}

model JobKnowledgeArea {
  id              String        @id @default(uuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  knowledgeAreaId String
  knowledgeArea   KnowledgeArea @relation(fields: [knowledgeAreaId], references: [id])

  @@unique([jobId, knowledgeAreaId])
}

model JobApplication {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantUserId String
  applicantUser   User     @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime @default(now())

  @@unique([jobId, applicantUserId])
}

model VenueFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, venueId])
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ConnectionRequest {
  id          String                  @id @default(uuid())
  fromUserId  String
  fromUser    User                    @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                    @relation("ConnectionRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status      ConnectionRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  suburbId          String?
  suburb            Suburb?  @relation(fields: [suburbId], references: [id])
  professionalTitle String
  rightToWork       Boolean
  culturalIdentity  String?
  about             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills         Skill[]
  knowledgeAreas KnowledgeArea[]
  experiences    Experience[]
  certifications Certification[]
  endorsements   Endorsement[]
}

model Country {
  id        String @id @default(uuid())
  name      String @unique
  states    State[]
  businesses Business[]
}

model State {
  id        String  @id @default(uuid())
  name      String  @unique
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]
}

model City {
  id                String             @id @default(uuid())
  name              String             @unique
  stateId           String
  state             State              @relation(fields: [stateId], references: [id])
  profiles          Profile[]
  venues            Venue[]
  suburbs           Suburb[]
  posts             Post[]
  businessLocations BusinessLocation[]
}

model Post {
  id           String   @id @default(uuid())
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  cityId       String?
  city         City?    @relation(fields: [cityId], references: [id])
  createdAt    DateTime @default(now())
}

model Suburb {
  id       String    @id @default(uuid())
  name     String
  cityId   String
  city     City      @relation(fields: [cityId], references: [id])
  venues   Venue[]
  profiles Profile[]

  @@unique([name, cityId])
}

model Skill {
  id        String     @id @default(uuid())
  name      String     @unique
  profiles  Profile[]
  jobSkills JobSkill[]
}

model KnowledgeArea {
  id                String             @id @default(uuid())
  name              String             @unique
  profiles          Profile[]
  jobKnowledgeAreas JobKnowledgeArea[]
}

model Experience {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id])
  roleTitle String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
}

enum VenueVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model Venue {
  id                 String                  @id @default(uuid())
  name               String
  cityId             String?
  city               City?                   @relation(fields: [cityId], references: [id])
  suburbId           String?
  suburb             Suburb?                 @relation(fields: [suburbId], references: [id])
  venueTypeId        String
  venueType          VenueType               @relation(fields: [venueTypeId], references: [id])
  verificationStatus VenueVerificationStatus @default(UNVERIFIED)
  about              String?
  createdByUserId    String
  createdByUser      User                    @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                @default(now())

  specialties VenueSpecialty[]
  experiences Experience[]
  managers    VenueManager[]
  followers   VenueFollow[]
  activities  Activity[]
  invites     Invite[]
  jobs        Job[]
}

model VenueManager {
  id               String   @id @default(uuid())
  venueId          String
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("VenueManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("VenueManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())
  verified         Boolean  @default(true)

  @@unique([venueId, userId])
}

model VenueSpecialty {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model VenueType {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model CertificationType {
  id             String          @id @default(uuid())
  name           String          @unique
  certifications Certification[]
}

model Certification {
  id                  String            @id @default(uuid())
  profileId           String
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificationTypeId String
  certificationType   CertificationType @relation(fields: [certificationTypeId], references: [id])
  issueDate           DateTime
  expiryDate          DateTime?
}

model BusinessCategory {
  id         String     @id @default(uuid())
  name       String     @unique
  businesses Business[]
}

enum BusinessVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum BusinessLocationScope {
  SPECIFIC_CITIES
  COUNTRY
  GLOBAL
}

model Business {
  id                 String                     @id @default(uuid())
  name               String
  categoryId         String?
  category           BusinessCategory?          @relation(fields: [categoryId], references: [id])
  about              String?
  verificationStatus BusinessVerificationStatus @default(UNVERIFIED)
  locationScope      BusinessLocationScope       @default(SPECIFIC_CITIES)
  countryId          String?
  country            Country?                   @relation(fields: [countryId], references: [id])
  createdByUserId    String
  createdByUser      User                       @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                   @default(now())

  managers   BusinessManager[]
  followers  BusinessFollow[]
  activities Activity[]
  locations  BusinessLocation[]
  invites    Invite[]
}

model BusinessLocation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])

  @@unique([businessId, cityId])
}

model BusinessManager {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("BusinessManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("BusinessManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())
  verified         Boolean  @default(true)

  @@unique([businessId, userId])
}

model BusinessFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, businessId])
}

enum ManagerTargetType {
  VENUE
  BUSINESS
}

enum NominationStatus {
  PENDING
  APPROVED
  DECLINED
}

model ManagerNomination {
  id                String            @id @default(uuid())
  targetType        ManagerTargetType
  targetId          String
  nomineeUserId     String
  nomineeUser       User              @relation("ManagerNominationNominee", fields: [nomineeUserId], references: [id], onDelete: Cascade)
  message           String
  status            NominationStatus  @default(PENDING)
  createdAt         DateTime          @default(now())
  respondedByUserId String?
  respondedByUser   User?             @relation("ManagerNominationRespondedBy", fields: [respondedByUserId], references: [id])
  respondedAt       DateTime?
}

enum InviteType {
  GENERAL
  VENUE_COWORKER
  VENUE_MANAGER_NUDGE
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model Invite {
  id            String       @id @default(uuid())
  inviterUserId String
  inviterUser   User         @relation("InviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeEmail  String
  venueId       String?
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type          InviteType
  token         String       @unique
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  expiresAt     DateTime
}

// Shared by Comment and Nod so both post and activity engagement live in one
// pair of tables instead of four near-identical ones.
enum EngagementTargetType {
  POST
  ACTIVITY
}

model Comment {
  id           String               @id @default(uuid())
  targetType   EngagementTargetType
  targetId     String
  authorUserId String
  authorUser   User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime             @default(now())

  @@index([targetType, targetId])
}

model Nod {
  id         String               @id @default(uuid())
  targetType EngagementTargetType
  targetId   String
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())

  @@unique([targetType, targetId, userId])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  COMMENT
  NOD
  ENDORSEMENT_REQUEST
}

// Reuses EngagementTargetType's POST/ACTIVITY values plus CONNECTION_REQUEST,
// mirroring the targetType/targetId discriminator pattern used by Notice,
// Comment, and Nod rather than a dedicated join table per notification kind.
// SKILL/KNOWLEDGE_AREA (targetId = Skill.id / KnowledgeArea.id) back
// ENDORSEMENT_REQUEST notifications the same way.
enum NotificationTargetType {
  CONNECTION_REQUEST
  POST
  ACTIVITY
  SKILL
  KNOWLEDGE_AREA
}

enum EndorsementItemType {
  SKILL
  KNOWLEDGE_AREA
}

enum EndorsementRole {
  PEER
  MANAGER
}

// No FK on itemId — it points at a Skill.id or KnowledgeArea.id depending on
// itemType, the same discriminator-without-relation pattern Comment/Nod use
// for POST/ACTIVITY. Level is derived (not stored): MANAGER role present ->
// 3, else PEER present -> 2, else 1.
model Endorsement {
  id             String              @id @default(uuid())
  profileId      String
  profile        Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemType       EndorsementItemType
  itemId         String
  endorserUserId String
  endorserUser   User                @relation(fields: [endorserUserId], references: [id], onDelete: Cascade)
  endorserRole   EndorsementRole
  createdAt      DateTime            @default(now())

  @@unique([profileId, itemType, itemId, endorserUserId])
}

model Notification {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  sourceUserId String?
  sourceUser   User?                  @relation("NotificationSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  targetType   NotificationTargetType
  targetId     String
  read         Boolean                @default(false)
  dismissed    Boolean                @default(false)
  createdAt    DateTime               @default(now())

  @@index([userId, read])
}
