// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isVenueAdmin Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  profile      Profile?
  venues       Venue[]

  managedVenues         VenueManager[]       @relation("VenueManagerUser")
  assignedVenueManagers VenueManager[]       @relation("VenueManagerAssignedBy")
  passwordResetTokens   PasswordResetToken[]

  managerNominations         ManagerNomination[] @relation("ManagerNominationNominee")
  respondedManagerNominations ManagerNomination[] @relation("ManagerNominationRespondedBy")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionRequestFrom")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionRequestTo")

  venueFollows VenueFollow[]

  businesses Business[]

  managedBusinesses        BusinessManager[] @relation("BusinessManagerUser")
  assignedBusinessManagers BusinessManager[] @relation("BusinessManagerAssignedBy")
  businessFollows          BusinessFollow[]

  activities Activity[]
  posts      Post[]
  notices    Notice[]
}

enum ActivityType {
  SIGNUP
  CONNECTION_MADE
  EXPERIENCE_ADDED
  CERTIFICATION_ADDED
  PROFILE_UPDATED
  VENUE_VERIFIED
  BUSINESS_VERIFIED
  NOTICE_POSTED
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  actorUserId String?
  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  noticeId    String?      @unique
  notice      Notice?      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
}

model Notice {
  id           String            @id @default(uuid())
  targetType   ManagerTargetType
  targetId     String
  authorUserId String
  authorUser   User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime          @default(now())

  activity Activity?
}

model VenueFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, venueId])
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ConnectionRequest {
  id          String                  @id @default(uuid())
  fromUserId  String
  fromUser    User                    @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                    @relation("ConnectionRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status      ConnectionRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  professionalTitle String
  rightToWork       Boolean
  culturalIdentity  String?
  about             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills         Skill[]
  knowledgeAreas KnowledgeArea[]
  experiences    Experience[]
  certifications Certification[]
}

model Country {
  id        String @id @default(uuid())
  name      String @unique
  cities    City[]
  businesses Business[]
}

model City {
  id                String             @id @default(uuid())
  name              String             @unique
  countryId         String
  country           Country            @relation(fields: [countryId], references: [id])
  profiles          Profile[]
  venues            Venue[]
  suburbs           Suburb[]
  posts             Post[]
  businessLocations BusinessLocation[]
}

model Post {
  id           String   @id @default(uuid())
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String
  cityId       String?
  city         City?    @relation(fields: [cityId], references: [id])
  createdAt    DateTime @default(now())
}

model Suburb {
  id     String  @id @default(uuid())
  name   String
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  venues Venue[]

  @@unique([name, cityId])
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model KnowledgeArea {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model Experience {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id])
  roleTitle String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
}

enum VenueVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model Venue {
  id                 String                  @id @default(uuid())
  name               String
  cityId             String?
  city               City?                   @relation(fields: [cityId], references: [id])
  suburbId           String?
  suburb             Suburb?                 @relation(fields: [suburbId], references: [id])
  state              String?
  country            String?
  venueTypeId        String?
  venueType          VenueType?              @relation(fields: [venueTypeId], references: [id])
  verificationStatus VenueVerificationStatus @default(UNVERIFIED)
  about              String?
  createdByUserId    String
  createdByUser      User                    @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                @default(now())

  specialties VenueSpecialty[]
  experiences Experience[]
  managers    VenueManager[]
  followers   VenueFollow[]
  activities  Activity[]
}

model VenueManager {
  id               String   @id @default(uuid())
  venueId          String
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("VenueManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("VenueManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())

  @@unique([venueId, userId])
}

model VenueSpecialty {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model VenueType {
  id     String  @id @default(uuid())
  name   String  @unique
  venues Venue[]
}

model CertificationType {
  id             String          @id @default(uuid())
  name           String          @unique
  certifications Certification[]
}

model Certification {
  id                  String            @id @default(uuid())
  profileId           String
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificationTypeId String
  certificationType   CertificationType @relation(fields: [certificationTypeId], references: [id])
  issueDate           DateTime
  expiryDate          DateTime?
}

model BusinessCategory {
  id         String     @id @default(uuid())
  name       String     @unique
  businesses Business[]
}

enum BusinessVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum BusinessLocationScope {
  SPECIFIC_CITIES
  COUNTRY
  GLOBAL
}

model Business {
  id                 String                     @id @default(uuid())
  name               String
  categoryId         String?
  category           BusinessCategory?          @relation(fields: [categoryId], references: [id])
  about              String?
  verificationStatus BusinessVerificationStatus @default(UNVERIFIED)
  locationScope      BusinessLocationScope       @default(SPECIFIC_CITIES)
  countryId          String?
  country            Country?                   @relation(fields: [countryId], references: [id])
  createdByUserId    String
  createdByUser      User                       @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime                   @default(now())

  managers   BusinessManager[]
  followers  BusinessFollow[]
  activities Activity[]
  locations  BusinessLocation[]
}

model BusinessLocation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])

  @@unique([businessId, cityId])
}

model BusinessManager {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("BusinessManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedByUser   User     @relation("BusinessManagerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())

  @@unique([businessId, userId])
}

model BusinessFollow {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, businessId])
}

enum ManagerTargetType {
  VENUE
  BUSINESS
}

enum NominationStatus {
  PENDING
  APPROVED
  DECLINED
}

model ManagerNomination {
  id                String            @id @default(uuid())
  targetType        ManagerTargetType
  targetId          String
  nomineeUserId     String
  nomineeUser       User              @relation("ManagerNominationNominee", fields: [nomineeUserId], references: [id], onDelete: Cascade)
  message           String
  status            NominationStatus  @default(PENDING)
  createdAt         DateTime          @default(now())
  respondedByUserId String?
  respondedByUser   User?             @relation("ManagerNominationRespondedBy", fields: [respondedByUserId], references: [id])
  respondedAt       DateTime?
}
